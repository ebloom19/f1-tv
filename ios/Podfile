# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :tvos, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Pitwall' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 16/26's Clang rejects fmt's consteval compile-time format-string checks
    # ("call to consteval function ... is not a constant expression"), which breaks the
    # fmt/Folly/React pods that RN 0.83 pins. RN builds these C++ dependencies through its
    # own prebuilt path that ignores per-target build settings, so a -D flag never reaches
    # the compile. Patch fmt's header directly to force its runtime-checking path; this hook
    # re-applies the edit on every `pod install`.
    require 'fileutils'
    marker = '// pitwall-consteval-patch'
    fmt_include = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt')
    %w[base.h core.h].each do |name|
      path = File.join(fmt_include, name)
      next unless File.exist?(path)
      contents = File.read(path)
      next unless contents.include?('FMT_USE_CONSTEVAL')
      next if contents.start_with?(marker)
      patched = "#{marker}\n#ifndef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#endif\n#{contents}"
      # fmt's headers are hardlinked read-only from the CocoaPods cache. Make the entry
      # writable and unlink it first so we write a fresh copy without touching the cache.
      FileUtils.chmod('u+w', path) rescue nil
      File.delete(path) rescue nil
      File.write(path, patched)
      Pod::UI.puts "[Pitwall] Patched fmt/#{name}: forced FMT_USE_CONSTEVAL=0".green
    end

    # Belt-and-suspenders: fmt's prefix header is force-included (-include) into every fmt
    # translation unit and is always writable, so defining the macro here guarantees it is
    # set before any fmt header is parsed, regardless of which header holds the guard.
    pch = File.join(installer.sandbox.root, 'Target Support Files', 'fmt', 'fmt-prefix.pch')
    if File.exist?(pch)
      pch_contents = File.read(pch)
      unless pch_contents.include?(marker)
        File.write(pch, "#{pch_contents}\n#{marker}\n#ifndef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#endif\n")
        Pod::UI.puts '[Pitwall] Patched fmt-prefix.pch: forced FMT_USE_CONSTEVAL=0'.green
      end
    end
  end
end
