# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :tvos, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Pitwall' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 16/26's Clang rejects fmt's consteval compile-time format-string checks
    # ("call to consteval function ... is not a constant expression"), which breaks the
    # fmt/Folly/React pods that RN 0.83 pins. Force fmt onto its runtime-checking path by
    # passing the flag straight to clang (OTHER_CPLUSPLUSFLAGS avoids the xcconfig-merge
    # ambiguity that makes GCC_PREPROCESSOR_DEFINITIONS unreliable here).
    patched = 0
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        flags = flags.split(' ') if flags.is_a?(String)
        next if flags.include?('-DFMT_USE_CONSTEVAL=0')
        flags << '-DFMT_USE_CONSTEVAL=0'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags
        patched += 1
      end
    end
    Pod::UI.puts "[Pitwall] Disabled fmt consteval on #{patched} target configs (FMT_USE_CONSTEVAL=0)".green
  end
end
