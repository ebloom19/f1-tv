# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :tvos, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Pitwall' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 16/26's Clang rejects fmt's consteval compile-time format-string checks
    # ("call to consteval function ... is not a constant expression"), which breaks the
    # fmt/Folly/React pods that RN 0.83 pins. RN builds these C++ dependencies through its
    # own prebuilt path that ignores per-target build settings, so a -D flag never reaches
    # the compile. In fmt 11.0.2 the FMT_USE_CONSTEVAL switch is set by an unguarded
    # #if/#elif chain, so pre-defining it is overwritten a few lines later. Rewrite fmt's
    # own "on" branch to 0 so the consteval path is disabled at the source. Idempotent; the
    # hook re-applies on every `pod install`.
    require 'fileutils'
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      patched = contents.gsub(/(define\s+FMT_USE_CONSTEVAL\s+)1\b/, '\10')
      if patched != contents
        # fmt's headers are hardlinked read-only from the CocoaPods cache; unlink first so we
        # write a fresh copy instead of mutating the shared cache.
        FileUtils.chmod('u+w', fmt_base) rescue nil
        File.delete(fmt_base) rescue nil
        File.write(fmt_base, patched)
        Pod::UI.puts '[Pitwall] Patched fmt/base.h: FMT_USE_CONSTEVAL forced to 0'.green
      end
    end
  end
end
